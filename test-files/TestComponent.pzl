<puzzle-view class="test-component {#if active}is-active{/if}">
  <!-- Puzzle expressions in comments stay comments: {#if ignored}{/if} -->
  <header style="background:{ headerColor }; transform:translateX({ offset }px)">
    <h1>{ title | trim | capitalize }</h1>
  </header>

  {#if loading}
    <p>Loading…</p>
  {:else if error}
    <p>{ error.message }</p>
  {:else}
    {#for item in items, index}
      <ItemCard
        item={ item }
        position={ index + 1 }
        @play:once={ play(item) }
        @keydown:enter:prevent={ open(item) } />
    {/for}

    {#unless items.length}
      <p>No items found.</p>
    {/unless}
  {/if}

  {#case status}
    {:when 'ready', 'playing'}<p>Ready</p>
    {:else}<p>Idle</p>
  {/case}

  {#svg 'icons/play.svg'}

  {## inline note with an apostrophe won't break }
  {## outer { user.name } tail }
  {## escaped brace \} still inside }

  {#comment}
    Raw body: { interpolation } and {#if flag}branch{/if} and <!-- html -->
    {#comment}nested opener{/comment}
    still commented after the inner close
  {/comment}

  {#comment note text}shorthand{/comment}
  {#comment} spaced closer {/ comment }

  {#commentary}

  <Card>
    <Slot name="header"><h2>{ title | capitalize }</h2></Slot>
    <Children>
      {#if items.length}<ItemCard item={ items[0] } />{:else}<p>Fallback body</p>{/if}
    </Children>
  </Card>
  <Slot>{ offset | number } remaining{#svg 'icons/empty.svg'}</Slot>
  <Children/>
  <Slot name="footer"/>

  <Portal><p>{ title }</p></Portal>

  <UserList users={ items }>
    <Snippet fits="row" user group><b>{ user.name }</b></Snippet>
  </UserList>
  <Slot name="row" user={ items[0] }>no rows</Slot>
  <SnippetHost/>

  <Frame.Wrapper class="dotted">
    <Frame.Content>{ title }</Frame.Content>
    <Frame.Inner.Deep/>
  </Frame.Wrapper>
  <Slot.Custom/>

  <div ref="listRoot" island key={ items[0] } flip></div>
  <div flip={ offset } key="row-{ offset }" data-island="not-a-directive"></div>
  <button @click:outside={ close() }>Close</button>

  {#raw}
    Inert braces: { notInterpolated } plus {#if never}branchless{/if} plus { pipes | notAFormatter }
    <b class="bold">structural html</b> and <Slot/> and <Portal>plain tag</Portal>
    <Card ref="literalRef" island key="literalKey" flip>markers are plain here</Card>
    <button @click={ notAnEvent }>inert binding</button>
  {/raw}

  {#raw json}{ "hint": "ignored by the compiler" }{/ raw }

  {#raw json}{ inertAfterHint }{/raw }{ liveAgain }
  {#raw}outer {#raw} nonNesting{/raw} liveTail

  <slot name="nope"></slot>
  <children></children>
  <portal></portal>
  <slot-machine class="not-a-marker"></slot-machine>

  <p class="{#raw}illegal in attribute{/raw}">attribute raw</p>
</puzzle-view>

<puzzle-skeleton min-duration="250">
  <div class="skeleton">
    {#for 1...4, n}<div class="row">{ n }</div>{/for}
  </div>
</puzzle-skeleton>

<script lang="ts">
import { PuzzleView } from '@magic-spells/puzzle';
import ItemCard from './ItemCard.pzl';

interface Item {
  id: string;
  title: string;
}

export default class TestComponent extends PuzzleView {
  data(params: Record<string, string>, props: { items?: Item[] }) {
    return {
      active: true,
      error: null,
      headerColor: '#202030',
      items: props.items ?? [],
      loading: false,
      offset: 0,
      status: 'ready',
      title: 'Test Component'
    };
  }

  events = {
    play: (item: Item) => item,
    open: (item: Item) => item
  };
}
</script>

<style scoped>
.test-component {
  display: grid;
  gap: 1rem;
}

.row {
  color: rebeccapurple;
}
</style>
